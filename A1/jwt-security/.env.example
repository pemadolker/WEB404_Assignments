# Copy this file to .env and fill in real values.
# .env must never be committed to version control.

PORT=3000

# Which JWT config to load: "vulnerable" or "secure"
AUTH_MODE=vulnerable

# --- Vulnerable mode secret (intentionally weak, for demonstration only) ---
JWT_VULN_SECRET=secret123

# --- Secure mode secret (generate with the command below, do NOT reuse this placeholder) ---
JWT_SECURE_SECRET=replace_this_with_generated_value

# Access token lifetime for secure mode
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Claims used for validation in secure mode
JWT_ISSUER=jwt-security-lab
JWT_AUDIENCE=jwt-security-lab-clients
